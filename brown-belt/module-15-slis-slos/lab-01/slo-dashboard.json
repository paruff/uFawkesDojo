{
  "dashboard": {
    "uid": "dojo-slo-grafana-api",
    "title": "Dojo SLO - Grafana API",
    "tags": ["dojo", "slo"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "15s",
    "time": { "from": "now-30m", "to": "now" },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Availability SLI (5m)",
        "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [{ "refId": "A", "expr": "sli:grafana_api:availability:ratio_5m * 100" }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 99.5 },
                { "color": "green", "value": 99.9 }
              ]
            }
          },
          "overrides": []
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Latency SLI: answered in 500 ms (5m)",
        "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [{ "refId": "A", "expr": "sli:grafana_api:latency_500ms:ratio_5m * 100" }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 95 },
                { "color": "green", "value": 99 }
              ]
            }
          },
          "overrides": []
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Burn rate (1h)",
        "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [{ "refId": "A", "expr": "error_budget:grafana_api:availability:burn_rate_1h" }],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "decimals": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 14.4 }
              ]
            }
          },
          "overrides": []
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Availability SLO target",
        "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [{ "refId": "A", "expr": "slo:grafana_api:availability:target * 100" }],
        "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1 }, "overrides": [] }
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Burn rate, 5m and 1h",
        "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          { "refId": "A", "expr": "error_budget:grafana_api:availability:burn_rate_5m", "legendFormat": "5m" },
          { "refId": "B", "expr": "error_budget:grafana_api:availability:burn_rate_1h", "legendFormat": "1h" }
        ]
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Requests per second by status code",
        "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (status_code) (rate(grafana_http_request_duration_seconds_count[5m]))",
            "legendFormat": "{{status_code}}"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
